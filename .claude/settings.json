{
  "permissions": {
    "allow": [
      "Bash(pkill -f bun)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$(jq -r '.prompt // empty')\"; if echo \"$p\" | grep -qE '승인|컨펌|확정|최종.*(이야|이다|해|하자|본)|발행하|완료(됐|다|야|해)|이걸로.*(하자|가자|끝|최종)'; then echo \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"UserPromptSubmit\\\",\\\"additionalContext\\\":\\\"[llm-wiki reminder] 방금 메시지가 최종 승인으로 보입니다. 이번 대화에서 완성된 산출물이 있다면 llm-wiki(Google Drive: KyleChoi Project/llm-wiki)에 ingest할지 검토하세요.\\\"}}\"; fi",
            "timeout": 5
          }
        ]
      }
    ]
  },
