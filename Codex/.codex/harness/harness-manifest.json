{
  "schema": "codex-harness.v1",
  "purpose": "Safety-first AI agent engineering workflow",
  "entrypoint": "AGENTS.md",
  "required_reading": [
    "AGENTS.md",
    ".codex/harness/safe-development-protocol.md",
    ".codex/harness/quality-gates.md",
    ".codex/harness/agent-checklist.md"
  ],
  "templates": {
    "repo_orientation": ".codex/harness/repo-orientation-template.md",
    "change_report": ".codex/harness/change-report-template.md"
  },
  "checks": [
    {
      "name": "agent-harness-check",
      "command": "sh scripts/agent-harness-check.sh",
      "required_for": [
        "docs",
        "characterization",
        "bugfix",
        "feature",
        "refactor",
        "infra"
      ]
    }
  ],
  "gates": {
    "0": "harness-only or documentation-only change",
    "1": "local behavior change",
    "2": "shared contract change",
    "3": "high-risk change"
  },
  "high_risk_areas": [
    "authentication",
    "authorization",
    "secrets",
    "payments",
    "data deletion",
    "database migration",
    "production deployment",
    "privacy-sensitive user data"
  ]
}

