# ============================================================
# DiA Ai Edu. Solution — .gitignore
# 목적: 시크릿·자격증명 + 주인님 개인/교회 데이터 보호
# (프레임워크 코드·조직구조는 추적, 개인 데이터·비밀은 제외)
# ============================================================

# ---------- 🔐 시크릿 / 자격증명 (절대 커밋 금지) ----------
.secrets/
*.env
.env
.env.*
*client_secret*.json
*.apps.googleusercontent.com.json
*service*account*.json
*credentials*.json
*token*.json
*.pem
*.key
.wp-config.json
.mcp.json
**/credentials/

# ---------- 🗂 개인 / 교회 데이터 (주인님 전용 — 누구나 사용 위해 제외) ----------
# 작업 산출물 (설교·투자·환경스캐닝·강의 등 개인 콘텐츠)
output/
# 교회 SOT 데이터 (설교계획·기도제목)
목회사역본부/weekly-works/output/
목회사역본부/weekly-works/data/
목회사역본부/weekly-works/.wp-config.json
# 교회 회계 데이터
church-accounting/data/
# NotebookLM 개인 작업
리서치본부/notebookLM/
# 마스터 작업기억 (개인 세션 상태)
SESSION_STATE.md
RECOVERY.md
.superpowers/

# ---------- ⚙️ 로컬 설정 / 환경 ----------
.claude/settings.local.json
.DS_Store
**/.DS_Store
node_modules/
*.log
.venv/
__pycache__/

# ---------- 📦 빌드 / 임시 ----------
dist/
build/
.cache/
*.bak
CLAUDE.md.bak
